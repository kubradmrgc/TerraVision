{
  "Email": {
    "Enabled": true,
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "Username": "apikey-or-smtp-user",
    "Password": "your-smtp-password",
    "FromAddress": "noreply@yourdomain.com",
    "FromDisplayName": "TerraVision"
  },
  "CartAbandonment": {
    "AbandonmentThresholdHours": 24,
    "ScanIntervalMinutes": 15,
    "SendReminderEmail": true,
    "EmailSubject": "Sepetinizde bitkileriniz sizi bekliyor!",
    "CartPageUrl": "https://shop.yourdomain.com/cart"
  },
  "RateLimiting": {
    "AuthSensitive": { "PermitLimit": 5, "WindowMinutes": 1 },
    "AppointmentsWrite": { "PermitLimit": 10, "WindowMinutes": 1 },
    "CatalogRead": { "PermitLimit": 120, "WindowMinutes": 1 }
  },
  "MediaStorage": {
    "Provider": "S3",
    "EnablePresignedUploads": true,
    "PresignExpiryMinutes": 15,
    "PublicBaseUrl": "https://cdn.example.com",
    "S3": {
      "Bucket": "terravision-media",
      "Region": "eu-west-1",
      "ServiceUrl": "",
      "ForcePathStyle": false
    }
  }
}
