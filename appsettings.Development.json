{
  "Email": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "noreply@terravision.local",
    "FromDisplayName": "TerraVision Dev"
  },
  "CartAbandonment": {
    "AbandonmentThresholdHours": 24,
    "ScanIntervalMinutes": 15,
    "SendReminderEmail": true,
    "CartPageUrl": "http://localhost:3000/cart"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MediaStorage": {
    "Provider": "Local",
    "EnablePresignedUploads": false,
    "PresignExpiryMinutes": 15,
    "PublicBaseUrl": "",
    "Prefixes": {
      "ArModels": "ar-models",
      "ArScreenshots": "ar-sessions",
      "ProductImages": "product-images"
    },
    "S3": {
      "Bucket": "terravision-media",
      "Region": "us-east-1",
      "AccessKey": "",
      "SecretKey": "",
      "ServiceUrl": "",
      "ForcePathStyle": true
    }
  }
}
