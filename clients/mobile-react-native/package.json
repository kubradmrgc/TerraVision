{
  "name": "terravision-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "setup:android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/write-android-sdk-path.ps1",
    "setup:device": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-device.ps1",
    "android:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "start": "react-native start --port 8082",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "release:check": "npm run typecheck && npm run lint && npm run test -- --watch=false --runInBand",
    "sync:smoke": "node ../../scripts/clients-sync-smoke.mjs"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "^8.6.0",
    "@react-native-documents/picker": "^12.0.1",
    "@react-native-picker/picker": "^2.11.4",
    "@react-native/new-app-screen": "0.85.2",
    "@tanstack/react-query": "^5.100.9",
    "@terravision/shared": "file:../shared",
    "axios": "^1.12.2",
    "react": "19.2.3",
    "react-native": "0.85.2",
    "react-native-image-picker": "^8.2.1",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-url-polyfill": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.85.2",
    "@react-native/eslint-config": "0.85.2",
    "@react-native/jest-preset": "0.85.2",
    "@react-native/metro-config": "0.85.2",
    "@react-native/typescript-config": "0.85.2",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
